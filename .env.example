# Copy this file to .env and fill in your bot token. Never commit .env to git.

# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token

# Optional settings (defaults shown)
DB_PATH=voicebot.db
LOG_LEVEL=INFO
LOG_FILE=logs/voicebot.log
MAX_TEXT_LENGTH=3000
DEFAULT_LANGUAGE=en
# Leave empty to use the first voice of DEFAULT_LANGUAGE
DEFAULT_VOICE=en-US-JennyNeural
DEFAULT_SPEED=1.0
TTS_MAX_RETRIES=3
TTS_TIMEOUT=30
